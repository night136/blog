/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# 静态资源：长缓存 + 后台再验证（stale-while-revalidate）。
# 跨境网络抖动时浏览器直接命中本地缓存秒开，后台静默校验更新，
# 避免「刷新后 JS 不跑 / 读不到缓存」的问题（pages.dev 在大陆无节点，每次强校验都会跨境重下）。
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 业务脚本/样式：同上。改版后靠 stale-while-revalidate 后台更新，无需用户强刷。
/assets/app.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/style.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/content/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# 封面图：文件名带内容哈希（build.mjs 生成），换封面即换文件名，一年 immutable。
/generated/covers/*
  Cache-Control: public, max-age=31536000, immutable

# 列表/详情快照：长缓存 + 后台再验证（SWR）。
# 前端用 force-cache 即时读本地缓存秒开首屏；后台 /api/posts/meta 校验新鲜度并静默刷新最新文章。
/generated/posts.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/generated/posts/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# 首页 HTML 外壳：SWR，跨境刷新也能秒开旧壳，后台校验更新（1 分钟内自更新，避免手机端长期缓存旧壳）。
/
  Cache-Control: public, max-age=60, stale-while-revalidate=86400
