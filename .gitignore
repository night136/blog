# 依赖与构建产物（本博客是纯静态，无构建步骤，留空也行）
node_modules/
dist/
.DS_Store

# 编辑器/系统文件
*.swp
*~
.vscode/

# 本地临时文件
*.log

# 本地生成产物（logo 处理结果、临时图片等）
/outputs/

# 静态预渲染构建产物（由 build.mjs 在 Cloudflare Pages 构建时生成，不入库）
/generated/

# 资源内容哈希副本（历史遗留：build.mjs 已改为「稳定文件名 + ?v=内容哈希」，不再生成这些文件；
# 保留规则是为了清掉旧版本残留，别把历史哈希副本提交进来）
/assets/app.*.js
/assets/style.*.css
/assets/vendor/lunar.*.js
